# Configuration for ihlvn. Copy to .env and fill in.
#
# The real .env holds secrets and is not committed; this file exists so the
# settings a deployment needs are visible in the repository rather than only on
# the server.

# ---------------------------------------------------------------- the site --

# The URL a browser reaches this app at. Behind a proxy — as on Opalstack, where
# TLS is terminated in front and a domain is forwarded to a local port — this is
# the public https URL, not the port the app listens on.
#
# Almost everything host-dependent derives from this: the passkey relying party
# and its origins, whether cookies are marked Secure, the HiDrive OAuth
# redirect_uri, and the base of enrollment links. Set it and the rest follows.
PUBLIC_URL=http://localhost:8000

# The port to listen on. With a proxy in front this is the local port it
# forwards to, and has nothing to do with the port in PUBLIC_URL.
PORT=8000

# Where the built frontend lives, relative to the working directory.
SPA_PATH=ui/.output/public

# ------------------------------------------------------------- overrides ----
#
# All of these derive from PUBLIC_URL and are only needed when the derived value
# is not what you want.

# The domain a passkey is bound to. Defaults to PUBLIC_URL's host. Set it to a
# parent domain to let one credential serve several subdomains.
# PASSKEY_RPID=

# Origins a passkey ceremony may come from, comma separated. Defaults to
# PUBLIC_URL. A second origin is only needed while migrating between domains.
# PASSKEY_ORIGINS=

# Whether cookies are marked Secure. Defaults to whether PUBLIC_URL is https,
# which is what you want: a browser refuses a Secure cookie over plain http —
# Safari even on localhost — so sign-in fails silently if this is wrong.
# COOKIE_SECURE=

# Origins allowed to call this app cross-site. Empty is correct: the app serves
# its own frontend, so the browser is always on the origin it loaded the page
# from. Only needed for a separately hosted client.
# CORS_ORIGINS=

# COOKIE_NAME=jwt
# COOKIE_SAME_SITE=2
# JWT_DURATION=36000

# ------------------------------------------------------------------ data ----

DB_CONN=postgres://localhost:5432/authdb

# The content repository, as a git URL or a local path.
REPO_CONTENT=

# --------------------------------------------------------------- hidrive ----
#
# The OAuth client. Its redirect_uri is derived from PUBLIC_URL as
# <PUBLIC_URL>/hi/auth/authcode and must be registered with HiDrive exactly —
# changing the domain means updating it there too.
CLIENT_ID=
CLIENT_SECRET=

# The HiDrive account media is served from, and the directory keys resolve
# against. This is one configured account, not the viewer's: a film lives in one
# place, so the same entry has to resolve to the same bytes for everyone.
# Nothing outside MEDIA_ROOT can be addressed. Leaving MEDIA_ALIAS unset turns
# the media route off, and it then reports that rather than disappearing.
# MEDIA_ALIAS=
# MEDIA_ROOT=

# ------------------------------------------------------------------ mail ----

# SMTP_ADDR=
# SMTP_AUTH=
# SMTP_FROM=

# --------------------------------------------------------------- logging ----

# Verbose diagnostics, including CORS decisions.
# DEBUG=false
