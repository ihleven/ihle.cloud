# Where `make deploy` sends this app. Copy to deploy/.env and fill in.
#
# deploy/.env is not committed: a host and a path describe one person's server,
# not the project. Every setting can equally come from the environment, for a
# variable this file leaves unset, or from the command line, which overrides
# whatever is here:
#
#   make deploy DEPLOY_HOST=me@other.host DEPLOY_PATH=/srv/app
#
# Read as makefile syntax, so plain KEY=value lines, unquoted, and no `#` or `$`
# inside a value.

# The ssh destination, user@host.
DEPLOY_HOST=user@opalxyz.opalstack.com

# The application directory on the server. The binary, the start and stop
# scripts and the public/ frontend all live directly in it, and the server's own
# .env stays there untouched across deploys.
DEPLOY_PATH=/path/to/app/folder

# The name the binary is installed under. Defaults to the build output name, and
# only needs setting when the server expects something else — on Opalstack that
# is whatever the app was created as.
# DEPLOY_BIN=ihlvn

# The server's architecture. amd64 unless the host is ARM.
# DEPLOY_ARCH=amd64

# How to reach the host. A deploy key is usually not in the agent, so point ssh
# at it here.
DEPLOY_SSH=ssh -i ./id_rsa
